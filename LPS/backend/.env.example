# Copy this file to ".env" and adjust the values for your local setup.

# Environment marker used only for informational purposes right now.
ENVIRONMENT=local

# API version string exposed in /health.
API_VERSION=0.1.0

# PostgreSQL connection URL for SQLAlchemy.
# Common patterns on Windows:
#   - With password:
#       postgresql+psycopg://postgres:your_password@localhost:5432/lps_creativ
#   - Without password (not recommended outside local dev):
#       postgresql+psycopg://postgres@localhost:5432/lps_creativ
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/lps_creativ

# External video API (optional)
# 用于从公司已上线 App 的热门视频接口同步数据，拿到接口后可以在这里配置：
# EXTERNAL_VIDEO_API_URL=https://api.example.com/v1/videos/hot
# EXTERNAL_VIDEO_API_TOKEN=your_token_here

# External video image base URL (optional)
# 用于拼接外部排行榜返回的 pic 字段，例如：
#   pic = "uploads/images/20251108/xxx.jpg"
#   EXTERNAL_VIDEO_IMAGE_BASE = https://stcine.com/
# 最终 poster_url = https://stcine.com/uploads/images/20251108/xxx.jpg
# EXTERNAL_VIDEO_IMAGE_BASE=https://stcine.com/

